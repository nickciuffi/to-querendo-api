# Copie este arquivo para .env e preencha com valores reais.
# O .env nunca deve ser commitado (já está no .gitignore).

# Postgres
POSTGRES_DB=toQuerendo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque_por_uma_senha_forte

# Spring datasource — o container da app fala com o container do postgres pelo nome do serviço
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/toQuerendo
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=troque_por_uma_senha_forte

# JWT — gere um valor novo, não reaproveite o default hardcoded em application.properties
# ex.: openssl rand -base64 48
JWT_SECRET=troque_por_um_segredo_longo_e_aleatorio
JWT_EXPIRATION_MS=3600000

# App
PORT=8080

# Origens liberadas para CORS (separadas por vírgula), ex.: http://localhost:3000,https://meu-frontend.com
# "*" libera qualquer origem — ok por enquanto para os frontends testarem, restringir depois se necessário
CORS_ALLOWED_ORIGINS=*

# S3 (upload de imagens). A região deve ser a mesma do bucket.
# As credenciais NÃO ficam aqui: na EC2 use uma IAM Role; localmente use o AWS CLI configurado
# (aws configure) ou as variáveis AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY.
S3_BUCKET=nome-do-bucket
S3_REGION=sa-east-1
# URL pública base do bucket, sem barra final. O front usa o mesmo valor + o path devolvido pela API.
S3_PUBLIC_URL=https://nome-do-bucket.s3.sa-east-1.amazonaws.com

# Tuning da JVM — importante em instâncias com pouca RAM (ex.: EC2 t3.micro, 1GB)
JAVA_TOOL_OPTIONS=-Xmx384m -XX:MaxMetaspaceSize=128m -XX:+UseSerialGC
